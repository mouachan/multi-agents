# A2A domain agent image — one image per agent, selected at build time:
#   podman build --platform linux/amd64 -f agents/Containerfile --build-arg AGENT=claims-agent -t <registry>/claims-agent:<tag> .
FROM registry.access.redhat.com/ubi9/python-312:latest

ARG AGENT

WORKDIR /opt/app-root/src

COPY agents/shared/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY agents/shared/ ./shared/
COPY agents/${AGENT}/agent.py ./agent.py

ENV PYTHONUNBUFFERED=1
EXPOSE 8090

CMD ["python", "agent.py"]
