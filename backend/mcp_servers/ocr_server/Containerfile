# MCP server ocr-server. Build from backend/mcp_servers (the context holds shared/):
#   podman build --platform linux/amd64 -f ocr_server/Containerfile -t <registry>/ocr-server:<tag> .
FROM registry.access.redhat.com/ubi9/python-312:latest

# PDF pages to images
USER 0
RUN dnf install -y poppler-utils && dnf clean all
USER 1001

WORKDIR /opt/app-root/src
COPY shared/requirements.txt shared-requirements.txt
RUN pip install --no-cache-dir -r shared-requirements.txt
COPY ocr_server/requirements.txt ocr_server-requirements.txt
RUN pip install --no-cache-dir -r ocr_server-requirements.txt

COPY shared/ shared/
COPY ocr_server/server.py .

EXPOSE 8080
CMD ["python", "server.py"]
