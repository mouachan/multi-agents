# MCP Sandbox Exec Server - run_python in OpenShell sandboxes
FROM registry.access.redhat.com/ubi9/python-312:latest
USER 0
WORKDIR /app
COPY sandbox_exec_server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY shared/__init__.py shared/mcp_app.py ./shared/
COPY sandbox_exec_server/server.py .
RUN chmod -R 755 /app
USER 1001
EXPOSE 8080
CMD ["python", "server.py"]
