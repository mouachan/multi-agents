# Application Configuration
DEBUG=true
ENVIRONMENT=development
APP_NAME="Claims Processing Demo"
APP_VERSION=0.1.0

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=multi_agent_db
POSTGRES_USER=multi_agent_user
POSTGRES_PASSWORD=multi_agents_pass

# OGX Configuration (Red Hat OpenShift AI 3.5 — formerly LlamaStack)
OGX_ENDPOINT=http://ogx-service.multi-agents.svc.cluster.local:8321
OGX_API_KEY=
OGX_DEFAULT_MODEL=gpt-oss-120b
OGX_EMBEDDING_MODEL=nomic-embed-text-v1-5
OGX_EMBEDDING_DIMENSION=768
OGX_TIMEOUT=300
OGX_MAX_RETRIES=3

# MCP Servers Configuration
OCR_SERVER_URL=http://ocr-server.multi-agents.svc.cluster.local:8080
RAG_SERVER_URL=http://rag-server.multi-agents.svc.cluster.local:8080
GUARDRAILS_SERVER_URL=http://multi-agents-guardrails.multi-agents.svc.cluster.local  # NeMo Guardrails (Service port 80)
GUARDRAILS_CONFIG_ID=multi-agents

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage
DOCUMENTS_STORAGE_PATH=/mnt/documents
MAX_UPLOAD_SIZE_MB=10

# Processing Configuration
MAX_PROCESSING_TIME_SECONDS=300
DEFAULT_WORKFLOW_TYPE=standard
ENABLE_ASYNC_PROCESSING=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# API Configuration
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
