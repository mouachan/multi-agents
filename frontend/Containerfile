# Frontend (React + Vite), served by nginx. Build from the repository root:
#   podman build --platform linux/amd64 -t <registry>/frontend:<tag> frontend/
FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS build
USER 0
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM registry.redhat.io/ubi10/nginx-126:latest
USER 0
COPY --from=build /build/dist /opt/app-root/src
# /api is proxied to the backend; the rest is the single-page application
COPY nginx-http.conf /opt/app-root/etc/nginx.d/agentic.conf
COPY nginx-server.conf /opt/app-root/etc/nginx.default.d/agentic.conf
USER 1001
CMD ["/usr/libexec/s2i/run"]
