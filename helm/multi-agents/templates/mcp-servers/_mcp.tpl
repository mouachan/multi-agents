{{/*
MCP servers helpers.
Server keys under .Values.mcp (each one deployed as <key>-server, port 8080).
*/}}
{{- define "multi-agents.mcp.serverKeys" -}}
ocr rag claims tenders postal tracking sandbox
{{- end -}}

{{/*
OGX endpoint used by MCP servers: .Values.mcp.ogx.endpoint overrides the chart-wide OGX service.
*/}}
{{- define "multi-agents.mcp.ogxEndpoint" -}}
{{- if .Values.mcp.ogx.endpoint -}}
{{- .Values.mcp.ogx.endpoint -}}
{{- else -}}
{{- include "multi-agents.ogx.endpoint" . -}}
{{- end -}}
{{- end -}}

{{/*
Container env for an MCP server.
Usage: include "multi-agents.mcp.env" (dict "root" $ "name" "claims" "cfg" .Values.mcp.claims)
*/}}
{{- define "multi-agents.mcp.env" -}}
{{- $root := .root -}}
{{- include "postgres.env" $root }}
- name: OGX_ENDPOINT
  value: {{ include "multi-agents.mcp.ogxEndpoint" $root | quote }}
- name: OGX_EMBEDDING_MODEL
  value: {{ include "multi-agents.ogx.embeddingModel" $root | quote }}
- name: OGX_TIMEOUT
  value: {{ $root.Values.mcp.ogx.timeout | quote }}
{{- if eq .name "ocr" }}
- name: OGX_VISION_MODEL
  value: {{ include "multi-agents.ogx.chatModel" $root.Values.models.vision | quote }}
{{- end }}
{{- if and (eq .name "claims") $root.Values.mcp.sandbox.enabled }}
# compute_payout runs its computation with the run_python tool of the OpenShell sandbox
- name: SANDBOX_MCP_URL
  value: {{ include "multi-agents.mcp.serverUrl" (dict "root" $root "name" "sandbox") | quote }}
{{- end }}
{{- if $root.Values.guardrails.enabled }}
# personal data in the tool results is masked by the NeMo output rails (shared/personal_data.py)
- name: GUARDRAILS_ENDPOINT
  value: {{ include "multi-agents.guardrails.endpoint" $root | quote }}
- name: GUARDRAILS_CONFIG_ID
  value: {{ $root.Values.guardrails.configId | quote }}
- name: GUARDRAILS_MODEL
  value: {{ $root.Values.models.guardrails | quote }}
{{- end }}
{{- range $k, $v := .cfg.env }}
- name: {{ $k }}
  value: {{ $v | quote }}
{{- end }}
- name: PORT
  value: "8080"
- name: PYTHONUNBUFFERED
  value: "1"
{{- end -}}

{{/*
What the AI hub needs to deploy an MCP server from its catalog entry (Deploy MCP server): the
environment of the chart's MCPServer above, secret values as references to the platform's secrets.
The deploy form builds an MCPServer (mcp.x-k8s.io, MCP lifecycle operator) from it.
Usage: include "multi-agents.catalog.mcpRuntimeMetadata" (dict "root" $ "name" "claims" "cfg" .Values.mcp.claims) | fromJson
*/}}
{{- define "multi-agents.catalog.mcpRuntimeMetadata" -}}
{{- $help := dict
      "POSTGRES_HOST" "PostgreSQL host of the platform" "POSTGRES_PORT" "PostgreSQL port"
      "POSTGRES_USER" "PostgreSQL user" "POSTGRES_PASSWORD" "PostgreSQL password" "POSTGRES_DATABASE" "PostgreSQL database"
      "OGX_ENDPOINT" "OGX endpoint (embeddings, vision)" "OGX_EMBEDDING_MODEL" "Embedding model in OGX"
      "OGX_TIMEOUT" "Timeout of the OGX calls (seconds)" "OGX_VISION_MODEL" "Vision model of the OCR"
      "SANDBOX_MCP_URL" "MCP endpoint of the OpenShell sandbox (run_python)"
      "GUARDRAILS_ENDPOINT" "NeMo Guardrails: masks the personal data of the tool results"
      "GUARDRAILS_CONFIG_ID" "NeMo Guardrails configuration" "GUARDRAILS_MODEL" "Model of the NeMo LLM rails"
      "LOG_LEVEL" "Log level" "PORT" "Port of the MCP endpoint" "PYTHONUNBUFFERED" "Python logs without buffering" }}
{{- $config := list }}
{{- $secrets := dict }}
{{- range $e := include "multi-agents.mcp.env" . | fromYamlArray }}
{{- if $e.valueFrom }}
{{- $ref := $e.valueFrom.secretKeyRef }}
{{- $key := dict "key" $ref.key "envVarName" $e.name "required" true "description" (get $help $e.name | default $e.name) }}
{{- $_ := set $secrets $ref.name (append (get $secrets $ref.name | default list) $key) }}
{{- else }}
{{- $config = append $config (dict "name" $e.name "type" "config" "required" true "defaultValue" $e.value
      "description" (get $help $e.name | default $e.name)) }}
{{- end }}
{{- end }}
{{- $secretList := list }}
{{- range $name, $keys := $secrets }}
{{- $secretList = append $secretList (dict "name" $name "keys" $keys "mountAsFile" false
      "description" "Secret of the multi-agents platform (deploy in its namespace)") }}
{{- end }}
{{- dict "defaultPort" 8080 "mcpPath" "/mcp" "requiredEnvironmentVariables" $config
      "prerequisites" (dict "secrets" $secretList) | toJson }}
{{- end -}}

{{/*
In-cluster URL of an MCP server's Streamable HTTP endpoint.
Usage: include "multi-agents.mcp.serverUrl" (dict "root" $ "name" "claims")
*/}}
{{- define "multi-agents.mcp.serverUrl" -}}
http://{{ .name }}-server.{{ include "multi-agents.namespace" .root }}.svc.cluster.local:8080/mcp
{{- end -}}

{{/*
MCP Gateway (Kuadrant) — Service generated by the Gateway API controller is <gateway>-<gatewayClass>.
*/}}
{{- define "multi-agents.mcpGateway.serviceHost" -}}
{{ .Values.mcpGateway.gatewayName }}-{{ .Values.mcpGateway.gatewayClassName }}.{{ include "multi-agents.namespace" . }}.svc.cluster.local
{{- end -}}

{{/* Public listener hostname (Host header clients must send) */}}
{{- define "multi-agents.mcpGateway.listenerHostname" -}}
{{- .Values.mcpGateway.listenerHostname | default (include "multi-agents.mcpGateway.serviceHost" .) -}}
{{- end -}}

{{/* Internal wildcard domain of the "mcps" listener used for backend routing */}}
{{- define "multi-agents.mcpGateway.internalDomain" -}}
mcp-{{ include "multi-agents.namespace" . }}.local
{{- end -}}

{{/*
In-cluster MCP endpoint of the gateway (single federated endpoint for all tools).
Use this as server_url for OGX Responses API MCP tools.
*/}}
{{- define "multi-agents.mcpGateway.url" -}}
http://{{ include "multi-agents.mcpGateway.listenerHostname" . }}{{ if ne (int .Values.mcpGateway.listenerPort) 80 }}:{{ .Values.mcpGateway.listenerPort }}{{ end }}/mcp
{{- end -}}
